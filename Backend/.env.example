PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# From your Supabase project's Connect dialog / Settings > API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret. Never put this in Frontend/.env or browser code.
SUPABASE_SECRET_KEY=sb_secret_...
# Only needed for direct database connections; the LMS server does not use it.
SUPABASE_DB_URL=
# Legacy key aliases are supported if your project has not created the new keys.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
PASSWORD_RESET_REDIRECT=http://localhost:5173/reset-password
